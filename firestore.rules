rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /reviews/{reviewId} {
      // Anyone can read — needed for the carousel to load reviews
      allow read: if true;

      // Anyone can submit a new review, with basic data validation
      allow create: if request.resource.data.clientName is string
                    && request.resource.data.clientName.size() > 0
                    && request.resource.data.clientName.size() <= 80
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.platform in ['Writedom Bot', 'WritersHub Bot', 'Both Bots']
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      // No editing or deleting reviews from the client
      allow update, delete: if false;
    }

  }
}
